<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Sigla.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/ms_bg"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/ms_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ms_space_16"
        android:paddingEnd="@dimen/ms_space_16"
        android:paddingTop="@dimen/ms_space_12"
        android:paddingBottom="@dimen/ms_space_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReviewWordLabel"
                style="@style/Sigla.Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/ms_text"
                android:text="Word" />

            <TextView
                android:id="@+id/tvReviewWordHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/ms_text_secondary"
                android:text="Tap to review alternatives" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewWordConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ms_pill"
            android:backgroundTint="@color/ms_danger"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/ms_on_dark"
            android:textSize="11sp"
            android:text="62%" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
