<?xml version="1.0" encoding="utf-8"?>
<!-- Word Bank (spec §5, mockup tabs-v1). Bottom bar navigation (view_bottom_nav.xml).
     Grid mode shows the filter pills and category cards; typing a search switches to
     list mode (word rows). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ms_bg">

    <LinearLayout
        android:id="@+id/wordBankContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/ms_screen_padding"
        android:paddingTop="@dimen/ms_space_24"
        android:paddingEnd="@dimen/ms_screen_padding">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/MotionSpeak.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Word Bank" />
                <TextView
                    android:id="@+id/tvWordBankSubtitle"
                    style="@style/MotionSpeak.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 FSL signs" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadAllVideos"
                style="@style/Widget.MotionSpeak.IconButton"
                android:contentDescription="Download all demo videos for offline use"
                app:icon="@drawable/ic_download_all" />
        </LinearLayout>

        <!-- Search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ms_search_height"
            android:layout_marginTop="@dimen/ms_space_16"
            android:background="@drawable/bg_ms_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ms_space_16"
            android:paddingEnd="@dimen/ms_space_16">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search_line"
                android:tint="@color/ms_text_secondary" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                style="@style/MotionSpeak.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/ms_space_12"
                android:background="@null"
                android:hint="Search words…"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColorHint="@color/ms_text_secondary" />
        </LinearLayout>

        <!-- Practice progress. Hidden until the app has something to count. -->
        <LinearLayout
            android:id="@+id/practiceProgressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ms_space_12"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">
            <TextView
                android:id="@+id/tvPracticeProgress"
                style="@style/MotionSpeak.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Practiced 12 of 60" />
            <ProgressBar
                android:id="@+id/progressPractice"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="@dimen/ms_space_4"
                android:max="60"
                android:progress="0"
                android:progressBackgroundTint="@color/ms_tint"
                android:progressTint="@color/ms_brand"
                tools:progress="12" />
        </LinearLayout>

        <!-- Grid mode: pills + categories -->
        <LinearLayout
            android:id="@+id/categoryGridContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_8"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:fillViewport="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pillAll"
                        style="@style/Widget.MotionSpeak.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ms_touch_min"
                        android:layout_marginEnd="@dimen/ms_space_8"
                        android:text="All" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pillMedical"
                        style="@style/Widget.MotionSpeak.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ms_touch_min"
                        android:layout_marginEnd="@dimen/ms_space_8"
                        android:text="Medical (46)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pillGeneral"
                        style="@style/Widget.MotionSpeak.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ms_touch_min"
                        android:text="General (14)" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                style="@style/MotionSpeak.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_8"
                android:layout_marginBottom="@dimen/ms_space_8"
                android:text="Categories" />

            <!-- -6dp offsets the 6dp margin on each card so the grid lines up with
                 the screen padding. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/ms_bottom_bar_clearance" />
        </LinearLayout>

        <!-- List mode: search results -->
        <TextView
            android:id="@+id/tvEntryCount"
            style="@style/MotionSpeak.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ms_space_16"
            android:layout_marginBottom="@dimen/ms_space_8"
            android:visibility="gone"
            tools:text="Showing 24 words" />

        <FrameLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWords"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/ms_bottom_bar_clearance"
                android:visibility="gone" />
            <ProgressBar
                android:id="@+id/progressLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/ms_bottom_bar_clearance"
                android:indeterminateTint="@color/ms_brand"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingBottom="@dimen/ms_bottom_bar_clearance"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    style="@style/MotionSpeak.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No words found" />
                <TextView
                    style="@style/MotionSpeak.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_4"
                    android:gravity="center"
                    android:text="Try a different search, or connect to the internet to download the word bank." />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/view_bottom_nav" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
