<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/ms_radius_lg"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/ms_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ms_brand"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_space_20"
            android:paddingEnd="@dimen/ms_space_20"
            android:paddingTop="@dimen/ms_space_16"
            android:paddingBottom="@dimen/ms_space_16">

            <TextView
                android:id="@+id/tvReviewTitle"
                style="@style/Sigla.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review Uncertain Signs"
                android:textColor="@color/ms_on_brand" />

            <TextView
                android:id="@+id/tvReviewSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/ms_on_brand_secondary"
                android:text="Tap any word below to view alternatives or adjust" />
        </LinearLayout>

        <!-- Words List Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_space_16"
            android:paddingEnd="@dimen/ms_space_16"
            android:paddingTop="@dimen/ms_space_16"
            android:paddingBottom="@dimen/ms_space_16">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="320dp">

                <LinearLayout
                    android:id="@+id/layoutReviewWordsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismissReview"
                style="@style/Widget.Sigla.Chip"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="Close" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
