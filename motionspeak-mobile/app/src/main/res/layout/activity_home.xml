<?xml version="1.0" encoding="utf-8"?>
<!-- Home dashboard (spec §5; mockup home-v1.html). Top to bottom: greeting, search,
     "Start translating" hero, stats, categories, recent translations. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ms_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/ms_bottom_bar_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_screen_padding"
            android:paddingTop="@dimen/ms_space_24"
            android:paddingEnd="@dimen/ms_screen_padding">

            <!-- Greeting -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvGreetingTitle"
                        style="@style/Sigla.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ms_home_accent"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="24sp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Hi Maria!" />
                    <TextView
                        android:id="@+id/tvGreetingSubtitle"
                        style="@style/Sigla.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        tools:text="Good morning" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAvatar"
                    style="@style/Sigla.Text.BodyStrong"
                    android:layout_width="@dimen/ms_badge_size"
                    android:layout_height="@dimen/ms_badge_size"
                    android:layout_marginStart="@dimen/ms_space_12"
                    android:background="@drawable/bg_ms_circle_tint"
                    android:backgroundTint="@color/ms_home_tint"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/ms_home_accent"
                    android:visibility="gone"
                    tools:text="M"
                    tools:visibility="visible" />
            </LinearLayout>


            <!-- Hero -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                style="@style/Widget.Sigla.Card.Tint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_16"
                android:clickable="false"
                android:focusable="false"
                app:cardCornerRadius="@dimen/ms_radius_lg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ms_space_20"
                    android:paddingTop="@dimen/ms_space_20"
                    android:paddingEnd="@dimen/ms_space_12"
                    android:paddingBottom="@dimen/ms_space_20">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Sigla.Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ms_home_accent"
                            android:text="Start translating"
                            android:textSize="20sp" />
                        <TextView
                            style="@style/Sigla.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ms_space_4"
                            android:text="Tap, sign one word, and SigLa reads it for you." />
                        <com.example.motionspeak.SiriLinearGradientButton
                            android:id="@+id/btnHeroStart"
                            style="@style/Widget.Sigla.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ms_space_12"
                            app:backgroundTint="@android:color/transparent"
                            android:textColor="@color/ms_home_on_brand"
                            android:shadowColor="#4D000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            app:cornerRadius="@dimen/ms_radius_lg"
                            app:strokeWidth="0dp"
                            android:text="Open camera" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="105dp"
                        android:layout_marginStart="@dimen/ms_space_4"
                        android:importantForAccessibility="no"
                        android:src="@drawable/illus_onboard_translate" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- Quick Actions -->
            <TextView
                style="@style/Sigla.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_20"
                android:text="QUICK ACTIONS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/ms_text_secondary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_8"
                app:cardCornerRadius="@dimen/ms_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ms_divider"
                app:cardBackgroundColor="@color/ms_tint">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row 1: Sign Dictionary -->
                    <LinearLayout
                        android:id="@+id/actionSignDictionary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvStatWords" style="@style/Sigla.Text.StatValue"
                            android:textColor="@color/ms_home_accent"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            tools:text="89" />
                        <TextView style="@style/Sigla.Text.StatLabel"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:text="Words" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="68dp"
                        android:background="@color/ms_divider" />

                    <!-- Row 2: MediSIGN Reference -->
                    <LinearLayout
                        android:id="@+id/actionMediSignReference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvStatTotal" style="@style/Sigla.Text.StatValue"
                            android:textColor="@color/ms_home_accent"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            tools:text="12" />
                        <TextView style="@style/Sigla.Text.StatLabel"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:text="Translated today" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="68dp"
                        android:background="@color/ms_divider" />

                    <!-- Row 3: App Settings -->
                    <LinearLayout
                        android:id="@+id/actionAppSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvStatFavorites" style="@style/Sigla.Text.StatValue"
                            android:textColor="@color/ms_home_accent"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            tools:text="9" />
                        <TextView style="@style/Sigla.Text.StatLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Favorites" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_20"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/Sigla.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Categories" />
                <TextView
                    android:id="@+id/tvCategoriesViewAll"
                    style="@style/Sigla.Text.Link"
                    android:textColor="@color/ms_home_accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ms_touch_min"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/ms_space_8"
                    android:text="View all" />
            </LinearLayout>

            <!-- 6dp negative side margins offset the 6dp margin on each card so
                 the grid's outer edges line up with the screen padding. -->
            <GridLayout
                android:id="@+id/gridCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:columnCount="2"
                android:useDefaultMargins="false" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/ms_space_12"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Sigla.Text.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="App Settings"
                                android:textSize="15sp"
                                android:textColor="@color/ms_text" />
                            <TextView
                                style="@style/Sigla.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Font, language, TTS &amp; more"
                                android:textSize="12sp"
                                android:textColor="@color/ms_text_secondary" />
                        </LinearLayout>

            <!-- Recent translations -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_20"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/Sigla.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent translations" />
                <TextView
                    android:id="@+id/tvRecentViewAll"
                    style="@style/Sigla.Text.Link"
                    android:textColor="@color/ms_home_accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ms_touch_min"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/ms_space_8"
                    android:text="View all" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/recentEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    style="@style/Sigla.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your translations will appear here." />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_nav" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
