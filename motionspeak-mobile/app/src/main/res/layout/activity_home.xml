<?xml version="1.0" encoding="utf-8"?>
<!-- Home dashboard (spec §5; mockup home-v1.html). Top to bottom: greeting, search,
     "Start translating" hero, stats, categories, recent translations. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ms_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/ms_bottom_bar_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_screen_padding"
            android:paddingTop="@dimen/ms_space_24"
            android:paddingEnd="@dimen/ms_screen_padding">

            <!-- Greeting -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvGreetingTitle"
                        style="@style/Sigla.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Hi Maria!" />
                    <TextView
                        android:id="@+id/tvGreetingSubtitle"
                        style="@style/Sigla.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Good morning" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAvatar"
                    style="@style/Sigla.Text.BodyStrong"
                    android:layout_width="@dimen/ms_badge_size"
                    android:layout_height="@dimen/ms_badge_size"
                    android:layout_marginStart="@dimen/ms_space_12"
                    android:background="@drawable/bg_ms_circle_tint"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/ms_brand_text"
                    android:visibility="gone"
                    tools:text="M"
                    tools:visibility="visible" />
            </LinearLayout>


            <!-- Hero -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                style="@style/Widget.Sigla.Card.Tint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_16"
                android:clickable="false"
                android:focusable="false"
                app:cardCornerRadius="@dimen/ms_radius_lg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ms_space_20"
                    android:paddingTop="@dimen/ms_space_20"
                    android:paddingEnd="@dimen/ms_space_12"
                    android:paddingBottom="@dimen/ms_space_20">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Sigla.Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start Signing"
                            android:textSize="20sp" />
                        <TextView
                            style="@style/Sigla.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ms_space_4"
                            android:text="Point camera at signer and begin" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHeroStart"
                            style="@style/Widget.Sigla.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ms_space_12"
                            android:text="Open camera" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="105dp"
                        android:layout_marginStart="@dimen/ms_space_4"
                        android:importantForAccessibility="no"
                        android:src="@drawable/illus_onboard_translate" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- Quick Actions -->
            <TextView
                style="@style/Sigla.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_20"
                android:text="QUICK ACTIONS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/ms_text_secondary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_8"
                app:cardCornerRadius="@dimen/ms_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ms_divider"
                app:cardBackgroundColor="@color/ms_tint">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row 1: Sign Dictionary -->
                    <LinearLayout
                        android:id="@+id/actionSignDictionary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/ms_space_16"
                        android:paddingEnd="@dimen/ms_space_16"
                        android:paddingTop="@dimen/ms_space_12"
                        android:paddingBottom="@dimen/ms_space_12"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_ms_circle_tint"
                            android:backgroundTint="@color/ms_blue_soft">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_book_line"
                                app:tint="@color/ms_brand"
                                android:importantForAccessibility="no" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/ms_space_12"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Sigla.Text.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sign Dictionary"
                                android:textSize="15sp"
                                android:textColor="@color/ms_text" />
                            <TextView
                                android:id="@+id/tvSignDictionaryCount"
                                style="@style/Sigla.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="37 medical FSL signs"
                                android:textSize="12sp"
                                android:textColor="@color/ms_text_secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ms_text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="68dp"
                        android:background="@color/ms_divider" />

                    <!-- Row 2: MediSIGN Reference -->
                    <LinearLayout
                        android:id="@+id/actionMediSignReference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/ms_space_16"
                        android:paddingEnd="@dimen/ms_space_16"
                        android:paddingTop="@dimen/ms_space_12"
                        android:paddingBottom="@dimen/ms_space_12"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_ms_circle_tint"
                            android:backgroundTint="@color/ms_green_soft">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_hospital_box"
                                app:tint="@color/ms_success"
                                android:importantForAccessibility="no" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/ms_space_12"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Sigla.Text.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MediSIGN Reference"
                                android:textSize="15sp"
                                android:textColor="@color/ms_text" />
                            <TextView
                                style="@style/Sigla.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Based on UP Manila handbook"
                                android:textSize="12sp"
                                android:textColor="@color/ms_text_secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ms_text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="68dp"
                        android:background="@color/ms_divider" />

                    <!-- Row 3: App Settings -->
                    <LinearLayout
                        android:id="@+id/actionAppSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/ms_space_16"
                        android:paddingEnd="@dimen/ms_space_16"
                        android:paddingTop="@dimen/ms_space_12"
                        android:paddingBottom="@dimen/ms_space_12"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_ms_circle_tint"
                            android:backgroundTint="@color/ms_amber_soft">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_settings_line"
                                app:tint="@color/ms_warning"
                                android:importantForAccessibility="no" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/ms_space_12"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Sigla.Text.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="App Settings"
                                android:textSize="15sp"
                                android:textColor="@color/ms_text" />
                            <TextView
                                style="@style/Sigla.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Font, language, TTS &amp; more"
                                android:textSize="12sp"
                                android:textColor="@color/ms_text_secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ms_text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_nav" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
