<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Sigla.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/ms_bg"
    app:strokeWidth="1dp"
    app:strokeColor="@color/ms_divider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title bar / Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ms_brand"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_space_20"
            android:paddingEnd="@dimen/ms_space_20"
            android:paddingTop="@dimen/ms_space_16"
            android:paddingBottom="@dimen/ms_space_16">

            <TextView
                android:id="@+id/tvChoicesTitle"
                style="@style/Sigla.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Intended Sign"
                android:textColor="@color/ms_on_brand" />

            <TextView
                android:id="@+id/tvChoicesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:textSize="12sp"
                android:textColor="@color/ms_on_brand_secondary"
                android:text="Moderate confidence (62%), tap the blinking red words to adjust" />
        </LinearLayout>

        <!-- Choices body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ms_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_space_16"
            android:paddingEnd="@dimen/ms_space_16"
            android:paddingTop="@dimen/ms_space_16"
            android:paddingBottom="@dimen/ms_space_16">

            <TextView
                android:id="@+id/tvAlternativesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alternative Predictions:"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ms_text_secondary"
                android:layout_marginBottom="8dp" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="240dp">

                <LinearLayout
                    android:id="@+id/layoutAlternativesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </androidx.core.widget.NestedScrollView>

            <!-- Bottom action row: Distinct colored button shape for "Keep [Sign]" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeepCurrent"
                style="@style/Widget.Sigla.Button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                app:cornerRadius="23dp"
                app:backgroundTint="@color/ms_cat_blue_bg"
                android:textColor="@color/ms_cat_blue_text"
                android:text="Keep 'Sign'" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
