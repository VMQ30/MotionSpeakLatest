<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (spec §5). Bottom bar navigation (view_bottom_nav.xml).
     Scope:
       - Profile card (initial avatar, name, "Tap to change your name")
       - Audio card: Volume level, Voice type
       - Display card: Dark / Light mode toggle
       - App card: Replay onboarding tutorial
       - Reset to Default button
     No settings are added or removed except the name. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ms_bg">

    <!-- The id is what lets Android restore the scroll position when toggling
         dark mode recreates this screen; a view without one is not saved. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_screen_padding"
            android:paddingTop="@dimen/ms_space_24"
            android:paddingEnd="@dimen/ms_screen_padding"
            android:paddingBottom="@dimen/ms_bottom_bar_clearance">

            <TextView
                style="@style/MotionSpeak.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ms_cat_violet_accent"
                android:text="Settings" />

            <!-- Profile card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rowProfile"
                style="@style/Widget.MotionSpeak.Card.Brand"
                app:cardBackgroundColor="@color/ms_cat_violet_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_16"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ms_space_16">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_ms_circle_tint_on_brand"
                        android:backgroundTint="@color/ms_cat_violet_disc">
                        <TextView
                            android:id="@+id/tvProfileInitial"
                            style="@style/MotionSpeak.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/ms_cat_violet_text"
                            tools:text="J" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ms_space_12"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvProfileName"
                            style="@style/MotionSpeak.Text.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/ms_cat_violet_text"
                            tools:text="Jhoren" />
                        <TextView
                            style="@style/MotionSpeak.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ms_space_4"
                            android:text="Tap to change your name"
                            android:textColor="@color/ms_cat_violet_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════ AUDIO ════════════════════ -->
            <TextView
                style="@style/MotionSpeak.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_24"
                android:layout_marginBottom="@dimen/ms_space_8"
                android:text="Audio" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MotionSpeak.Card.Tint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ms_space_16">

                    <!-- Volume level -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Volume level" />
                        <TextView
                            android:id="@+id/tvVolumeValue"
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="70%" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ms_space_8"
                        android:max="100"
                        android:progress="70"
                        android:progressTint="@color/ms_cat_violet_bg"
                        android:thumbTint="@color/ms_cat_violet_bg" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/ms_space_16"
                        android:background="@color/ms_divider" />

                    <!-- Voice type -->
                    <TextView
                        style="@style/MotionSpeak.Text.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Voice type" />
                    <TextView
                        style="@style/MotionSpeak.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ms_space_4"
                        android:layout_marginBottom="@dimen/ms_space_12"
                        android:text="Voice used for text-to-speech" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/btnVoiceMale"
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ms_touch_min"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/ms_space_8"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_violet_bg"
                            android:gravity="center"
                            android:text="Male"
                            android:textColor="@color/ms_cat_violet_text" />

                        <TextView
                            android:id="@+id/btnVoiceFemale"
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ms_touch_min"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_violet_tint"
                            android:gravity="center"
                            android:text="Female"
                            android:textColor="@color/ms_cat_violet_accent" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/ms_space_16"
                        android:background="@color/ms_divider" />

                    <!-- Test audio button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestAudio"
                        style="@style/Widget.MotionSpeak.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ms_touch_min"
                        android:text="Test audio"
                        app:backgroundTint="@color/ms_cat_violet_bg"
                        android:textColor="@color/ms_cat_violet_text"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_volume_up"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/ms_space_8"
                        app:iconTint="@color/ms_cat_violet_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════ DISPLAY ════════════════════ -->
            <TextView
                style="@style/MotionSpeak.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_24"
                android:layout_marginBottom="@dimen/ms_space_8"
                android:text="Display" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MotionSpeak.Card.Tint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Dark mode row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/ms_space_16">

                        <FrameLayout
                            android:layout_width="@dimen/ms_badge_size"
                            android:layout_height="@dimen/ms_badge_size"
                            android:background="@drawable/bg_ms_circle_tint"
                            android:backgroundTint="@color/ms_cat_violet_tint">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_onboard_name"
                                android:tint="@color/ms_cat_violet_accent"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/ms_space_12"
                            android:orientation="vertical">
                            <TextView
                                style="@style/MotionSpeak.Text.BodyStrong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Dark mode" />
                            <TextView
                                android:id="@+id/tvDarkModeSubtitle"
                                style="@style/MotionSpeak.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ms_space_4"
                                tools:text="Currently using Light mode" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchDarkMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/ms_bg"
                            app:trackTint="@color/ms_cat_violet_bg" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/ms_space_16"
                        android:background="@color/ms_divider" />

                    <!-- Font size row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ms_space_16"
                        android:paddingTop="@dimen/ms_space_16"
                        android:paddingEnd="@dimen/ms_space_16"
                        android:paddingBottom="@dimen/ms_space_16">

                        <!-- Label row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                style="@style/MotionSpeak.Text.BodyStrong"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Font size" />
                            <TextView
                                android:id="@+id/tvFontSizeValue"
                                style="@style/MotionSpeak.Text.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="100%" />
                        </LinearLayout>

                        <!-- Continuous slider: progress 0–45 maps to 80%–125% -->
                        <SeekBar
                            android:id="@+id/seekFontSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ms_space_8"
                            android:max="45"
                            android:progress="20"
                            android:progressTint="@color/ms_cat_violet_bg"
                            android:thumbTint="@color/ms_cat_violet_bg" />

                        <!-- Preset buttons: Small / Normal / Large -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ms_space_12"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btnFontSmall"
                                style="@style/MotionSpeak.Text.BodyStrong"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/ms_touch_min"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/ms_space_8"
                                android:background="@drawable/bg_ms_pill"
                                android:backgroundTint="@color/ms_cat_violet_tint"
                                android:gravity="center"
                                android:text="Small"
                                android:textColor="@color/ms_cat_violet_accent" />

                            <TextView
                                android:id="@+id/btnFontNormal"
                                style="@style/MotionSpeak.Text.BodyStrong"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/ms_touch_min"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/ms_space_8"
                                android:background="@drawable/bg_ms_pill"
                                android:backgroundTint="@color/ms_cat_violet_bg"
                                android:gravity="center"
                                android:text="Normal"
                                android:textColor="@color/ms_cat_violet_text" />

                            <TextView
                                android:id="@+id/btnFontLarge"
                                style="@style/MotionSpeak.Text.BodyStrong"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/ms_touch_min"
                                android:layout_weight="1"
                                android:background="@drawable/bg_ms_pill"
                                android:backgroundTint="@color/ms_cat_violet_tint"
                                android:gravity="center"
                                android:text="Large"
                                android:textColor="@color/ms_cat_violet_accent" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════ HAPTICS ════════════════════ -->
            <TextView
                style="@style/MotionSpeak.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_24"
                android:layout_marginBottom="@dimen/ms_space_8"
                android:text="Haptics" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MotionSpeak.Card.Tint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ms_space_16">

                    <TextView
                        style="@style/MotionSpeak.Text.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Haptic feedback" />
                    <TextView
                        style="@style/MotionSpeak.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ms_space_4"
                        android:layout_marginBottom="@dimen/ms_space_12"
                        android:text="Vibration feedback for buttons and interactions" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnHapticOff"
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/ms_touch_min"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/ms_space_8"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_violet_tint"
                            android:gravity="center"
                            android:paddingStart="@dimen/ms_space_8"
                            android:paddingEnd="@dimen/ms_space_8"
                            android:paddingTop="@dimen/ms_space_8"
                            android:paddingBottom="@dimen/ms_space_8"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeStepGranularity="1sp"
                            android:maxLines="2"
                            android:text="Off"
                            android:textColor="@color/ms_cat_violet_accent" />

                        <TextView
                            android:id="@+id/btnHapticLight"
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/ms_touch_min"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/ms_space_8"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_violet_bg"
                            android:gravity="center"
                            android:paddingStart="@dimen/ms_space_8"
                            android:paddingEnd="@dimen/ms_space_8"
                            android:paddingTop="@dimen/ms_space_8"
                            android:paddingBottom="@dimen/ms_space_8"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeStepGranularity="1sp"
                            android:maxLines="2"
                            android:text="Light"
                            android:textColor="@color/ms_cat_violet_text" />

                        <TextView
                            android:id="@+id/btnHapticMax"
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/ms_touch_min"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_violet_tint"
                            android:gravity="center"
                            android:paddingStart="@dimen/ms_space_8"
                            android:paddingEnd="@dimen/ms_space_8"
                            android:paddingTop="@dimen/ms_space_8"
                            android:paddingBottom="@dimen/ms_space_8"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeStepGranularity="1sp"
                            android:maxLines="2"
                            android:text="Max"
                            android:textColor="@color/ms_cat_violet_accent" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════ SENTENCE GENERATION (LLM) ════════════════════ -->
            <TextView
                style="@style/MotionSpeak.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_24"
                android:layout_marginBottom="@dimen/ms_space_8"
                android:text="Sentence Generation" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MotionSpeak.Card.Tint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ms_space_16">

                    <!-- Enable/Disable LLM Sentence Synthesis Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/MotionSpeak.Text.BodyStrong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Natural sentence synthesis" />

                            <TextView
                                style="@style/MotionSpeak.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ms_space_4"
                                android:text="Compose natural sentences from recognized signs" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchLlmSynthesis"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ms_space_12"
                        android:layout_marginBottom="@dimen/ms_space_12"
                        android:background="@color/ms_divider" />

                    <!-- Output Sentence Language -->
                    <TextView
                        style="@style/MotionSpeak.Text.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sentence language" />

                    <TextView
                        style="@style/MotionSpeak.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ms_space_4"
                        android:layout_marginBottom="@dimen/ms_space_12"
                        android:text="Language for composed sentences" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnLangEnglish"
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ms_touch_min"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/ms_space_8"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_violet_bg"
                            android:gravity="center"
                            android:text="English"
                            android:textColor="@color/ms_cat_violet_text" />

                        <TextView
                            android:id="@+id/btnLangFilipino"
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ms_touch_min"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_violet_tint"
                            android:gravity="center"
                            android:text="Filipino"
                            android:textColor="@color/ms_cat_violet_accent" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ms_space_12"
                        android:layout_marginBottom="@dimen/ms_space_12"
                        android:background="@color/ms_divider" />

                    <!-- Offline LLM Model Status & Hardware Compatibility -->
                    <TextView
                        style="@style/MotionSpeak.Text.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="On-device LLM model" />

                    <TextView
                        android:id="@+id/tvLlmModelStatus"
                        style="@style/MotionSpeak.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ms_space_4"
                        android:text="Checking model status…" />

                    <TextView
                        android:id="@+id/tvLlmHardwareFitness"
                        style="@style/MotionSpeak.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ms_space_4"
                        android:textColor="@color/ms_cat_violet_accent"
                        android:text="Checking hardware compatibility…" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════ APP ════════════════════ -->
            <TextView
                style="@style/MotionSpeak.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_24"
                android:layout_marginBottom="@dimen/ms_space_8"
                android:text="App" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MotionSpeak.Card.Tint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/rowReplayTutorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ms_space_16">

                    <FrameLayout
                        android:layout_width="@dimen/ms_badge_size"
                        android:layout_height="@dimen/ms_badge_size"
                        android:background="@drawable/bg_ms_circle_tint"
                        android:backgroundTint="@color/ms_cat_violet_tint">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_play"
                            android:tint="@color/ms_cat_violet_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ms_space_12"
                        android:orientation="vertical">
                        <TextView
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Replay onboarding tutorial" />
                        <TextView
                            style="@style/MotionSpeak.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ms_space_4"
                            android:text="Review the app guide from the beginning" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════ RESET ════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MotionSpeak.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_24"
                app:strokeColor="@color/ms_danger">

                <LinearLayout
                    android:id="@+id/btnResetDefaults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ms_space_16">

                    <FrameLayout
                        android:layout_width="@dimen/ms_badge_size"
                        android:layout_height="@dimen/ms_badge_size"
                        android:background="@drawable/bg_ms_circle_tint">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_replay"
                            android:tint="@color/ms_danger" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ms_space_12"
                        android:orientation="vertical">
                        <TextView
                            style="@style/MotionSpeak.Text.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Reset to default"
                            android:textColor="@color/ms_danger" />
                        <TextView
                            style="@style/MotionSpeak.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ms_space_4"
                            android:text="Restores all settings to their original configuration" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
