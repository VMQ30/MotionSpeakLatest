<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_confirm_action.xml
     Generic destructive-action confirmation popup, restyled to the ms_*
     design system: navy title bar, ms_bg body with a bold message, and a
     Cancel / destructive-action pill pair. IDs are reusable for other
     confirmations beyond Clear All (Reset, Download all demo videos, …).
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/ms_radius_lg"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/ms_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ms_brand"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_space_20"
            android:paddingEnd="@dimen/ms_space_20"
            android:paddingTop="@dimen/ms_space_20"
            android:paddingBottom="@dimen/ms_space_16">

            <TextView
                android:id="@+id/tvConfirmTitle"
                style="@style/Sigla.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete all history?"
                android:textColor="@color/ms_on_brand" />
        </LinearLayout>

        <!-- Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ms_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_space_20"
            android:paddingEnd="@dimen/ms_space_20"
            android:paddingTop="@dimen/ms_space_24"
            android:paddingBottom="@dimen/ms_space_20">

            <TextView
                android:id="@+id/tvConfirmMessage"
                style="@style/Sigla.Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ms_space_24"
                android:text="This action cannot be undone." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmCancel"
                    style="@style/Widget.Sigla.Chip"
                    android:layout_marginEnd="@dimen/ms_space_8"
                    android:text="Cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmAction"
                    style="@style/Widget.Sigla.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ms_touch_min"
                    android:text="Delete" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
