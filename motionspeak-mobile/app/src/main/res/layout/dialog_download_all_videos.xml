<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_download_all_videos.xml
     Progress popup for the Word Bank bulk demo-video download, restyled to
     the ms_* design system. Same navy title bar / ms_bg body shell as
     dialog_confirm_action.xml, with a determinate bar, an "x of y" counter,
     the word currently in flight, and an explicit Cancel (the dialog itself
     is not cancelable).
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/ms_radius_lg"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/ms_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ms_brand"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_space_20"
            android:paddingEnd="@dimen/ms_space_20"
            android:paddingTop="@dimen/ms_space_20"
            android:paddingBottom="@dimen/ms_space_16">

            <TextView
                style="@style/MotionSpeak.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Downloading demo videos"
                android:textColor="@color/ms_on_brand" />
        </LinearLayout>

        <!-- Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ms_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_space_20"
            android:paddingEnd="@dimen/ms_space_20"
            android:paddingTop="@dimen/ms_space_20"
            android:paddingBottom="@dimen/ms_space_20">

            <TextView
                android:id="@+id/tvDownloadCounter"
                style="@style/MotionSpeak.Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preparing…" />

            <ProgressBar
                android:id="@+id/progressDownloadAll"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_12"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/ms_tint"
                android:progressTint="@color/ms_brand" />

            <TextView
                android:id="@+id/tvDownloadCurrentWord"
                style="@style/MotionSpeak.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_8"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ms_space_20"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadCancel"
                    style="@style/Widget.MotionSpeak.Chip"
                    android:text="Cancel" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
