<?xml version="1.0" encoding="utf-8"?>
<!-- Translator (spec §5). Camera fills the screen above
     an expanded bottom sheet; the sheet overlaps the camera by 28dp so its rounded
     top corners sit on the picture. Controls float over the camera. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ms_bg">

    <!-- Camera: from the top down to 28dp inside the sheet. -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/sheetOverlap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.motionspeak.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Top back button over the camera -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.Sigla.IconButton"
        android:layout_marginStart="@dimen/ms_space_16"
        android:layout_marginTop="@dimen/ms_space_16"
        android:contentDescription="Back"
        app:backgroundTint="@color/ms_bg"
        app:icon="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ════════════════════ TEST MODE PROMPT OVERLAY ════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutTestPromptBox"
        style="@style/Widget.Sigla.Card.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ms_screen_padding"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/ms_screen_padding"
        android:elevation="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/ms_bg"
        app:cardCornerRadius="@dimen/ms_radius_md"
        app:strokeColor="@color/ms_cat_violet_accent"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ms_space_12">

            <!-- Test Mode Phase Chips & Step indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/badgeTestMode"
                    style="@style/Sigla.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ms_pill"
                    android:backgroundTint="@color/ms_cat_violet_accent"
                    android:paddingStart="@dimen/ms_space_8"
                    android:paddingTop="2dp"
                    android:paddingEnd="@dimen/ms_space_8"
                    android:paddingBottom="2dp"
                    android:text="TEST MODE"
                    android:textColor="@color/ms_on_brand" />

                <TextView
                    android:id="@+id/tvTestPhaseTitle"
                    style="@style/Sigla.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ms_space_8"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ms_cat_violet_accent"
                    android:textStyle="bold"
                    tools:text="1: Single Signs &amp; Expressions" />

                <TextView
                    android:id="@+id/tvTestStepIndicator"
                    style="@style/Sigla.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ms_text_secondary"
                    tools:text="[1/25]" />

                <ImageView
                    android:id="@+id/btnMinimizeTestMenu"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="@dimen/ms_space_8"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Minimize test menu"
                    android:padding="3dp"
                    android:src="@drawable/ic_close_line"
                    app:tint="@color/ms_text_secondary" />
            </LinearLayout>

            <!-- Horizontal Tab Chips to switch between the 4 Tests -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipTest1"
                        style="@style/Sigla.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_ms_pill"
                        android:backgroundTint="@color/ms_cat_violet_bg"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="1: Single Signs"
                        android:textColor="@color/ms_cat_violet_text" />

                    <TextView
                        android:id="@+id/chipTest2"
                        style="@style/Sigla.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_ms_pill"
                        android:backgroundTint="@color/ms_cat_violet_tint"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="2: Sentences (BLEU)"
                        android:textColor="@color/ms_cat_violet_accent" />

                    <TextView
                        android:id="@+id/chipTest3"
                        style="@style/Sigla.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_ms_pill"
                        android:backgroundTint="@color/ms_cat_violet_tint"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="3: Speed &amp; Latency"
                        android:textColor="@color/ms_cat_violet_accent" />

                    <TextView
                        android:id="@+id/chipTest4"
                        style="@style/Sigla.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ms_pill"
                        android:backgroundTint="@color/ms_cat_violet_tint"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="4: Breaking Points"
                        android:textColor="@color/ms_cat_violet_accent" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Main Prompt display -->
            <TextView
                android:id="@+id/tvTestPromptHeading"
                style="@style/Sigla.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Please sign:"
                android:textColor="@color/ms_text_secondary" />

            <TextView
                android:id="@+id/tvTestPromptText"
                style="@style/Sigla.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ms_cat_violet_accent"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="SALAMAT" />

            <TextView
                android:id="@+id/tvTestPromptSub"
                style="@style/Sigla.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ms_text"
                tools:text='Target: "Thank You" • Facial expression: Happy / Smile' />

            <!-- Boundary selectors for Test 4 (Distance / Angle / Background) -->
            <LinearLayout
                android:id="@+id/layoutTestBoundarySelectors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Sigla.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Boundary test variables (tap to cycle):"
                    android:textColor="@color/ms_text_secondary" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipDistance"
                            style="@style/Sigla.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_teal_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="Dist: 1.0m"
                            android:textColor="@color/ms_on_brand" />

                        <TextView
                            android:id="@+id/chipAngle"
                            style="@style/Sigla.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_sky_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="Angle: 0°"
                            android:textColor="@color/ms_on_brand" />

                        <TextView
                            android:id="@+id/chipBackground"
                            style="@style/Sigla.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_indigo_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="Wall: Plain"
                            android:textColor="@color/ms_on_brand" />

                        <TextView
                            android:id="@+id/chipElevation"
                            style="@style/Sigla.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_purple_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="Elev: 0°"
                            android:textColor="@color/ms_on_brand" />

                        <TextView
                            android:id="@+id/chipSigner"
                            style="@style/Sigla.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_teal_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="Signer: 01"
                            android:textColor="@color/ms_on_brand" />

                        <TextView
                            android:id="@+id/chipIteration"
                            style="@style/Sigla.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ms_pill"
                            android:backgroundTint="@color/ms_cat_cyan_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="Iter: 1/10"
                            android:textColor="@color/ms_on_brand" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Real-time Telemetry & Live Prediction Feedback -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ms_search"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvTestTelemetryMetrics"
                    style="@style/Sigla.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ms_brand_text"
                    android:textStyle="bold"
                    tools:text="Lux: 350 lx • FPS: 28.5 • Latency: 142ms (MP: 28ms, CNN: 19ms)" />

                <TextView
                    android:id="@+id/tvTestLastPrediction"
                    style="@style/Sigla.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ms_text"
                    tools:text="Latest: SALAMAT (92% Conf) • MATCH ✓" />
            </LinearLayout>

            <!-- Action Controls: Prev, Next, and Sentence Synthesize trigger -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestPrev"
                    style="@style/Widget.Sigla.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="◀ Prev" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestSynthesize"
                    style="@style/Widget.Sigla.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.2"
                    android:text="Eval BLEU"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestNext"
                    style="@style/Widget.Sigla.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Next ▶"
                    app:backgroundTint="@color/ms_cat_violet_bg"
                    android:textColor="@color/ms_cat_violet_text"
                    app:cornerRadius="18dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Result card, floating under the top controls -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResult"
        style="@style/Widget.Sigla.Card.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ms_screen_padding"
        android:layout_marginTop="@dimen/ms_space_16"
        android:layout_marginEnd="@dimen/ms_screen_padding"
        android:visibility="invisible"
        app:cardCornerRadius="@dimen/ms_radius_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTestPromptBox"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ms_space_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/ms_badge_size"
                android:layout_height="@dimen/ms_badge_size"
                android:background="@drawable/bg_ms_circle_tint">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chat_line"
                    android:tint="@color/ms_brand_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/ms_space_12"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvResult"
                    style="@style/Sigla.Text.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="GOOD MORNING" />
                <TextView
                    android:id="@+id/tvFilipinoResult"
                    style="@style/Sigla.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:visibility="gone"
                    tools:text="Magandang umaga"
                    tools:visibility="visible" />
                <!-- Facial cue read with the sign (yes/no question, WH question, negation).
                     Hidden until the recognizer reports one. -->
                <TextView
                    android:id="@+id/tvFacialCue"
                    style="@style/Sigla.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ms_space_8"
                    android:background="@drawable/bg_ms_search"
                    android:paddingStart="@dimen/ms_space_12"
                    android:paddingTop="@dimen/ms_space_4"
                    android:paddingEnd="@dimen/ms_space_12"
                    android:paddingBottom="@dimen/ms_space_4"
                    android:textColor="@color/ms_brand_text"
                    android:visibility="gone"
                    tools:text="Yes/no question"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Result actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ms_space_12"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeakAgain"
                style="@style/Widget.Sigla.Chip"
                android:layout_marginEnd="@dimen/ms_space_8"
                android:contentDescription="Speak the translation again"
                android:text="Speak again" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyResult"
                style="@style/Widget.Sigla.Chip"
                android:contentDescription="Copy the translation"
                android:text="Copy" />
        </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvHandsWarning"
        style="@style/Sigla.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_space_8"
        android:background="@drawable/bg_ms_pill"
        android:backgroundTint="@color/ms_danger"
        android:paddingStart="@dimen/ms_space_12"
        android:paddingTop="@dimen/ms_space_4"
        android:paddingEnd="@dimen/ms_space_12"
        android:paddingBottom="@dimen/ms_space_4"
        android:text="More than 2 hands detected"
        android:textColor="@color/ms_on_dark"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvEnvWarning"
        style="@style/Sigla.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_space_8"
        android:background="@drawable/bg_ms_pill"
        android:backgroundTint="@color/ms_danger"
        android:paddingStart="@dimen/ms_space_12"
        android:paddingTop="@dimen/ms_space_4"
        android:paddingEnd="@dimen/ms_space_12"
        android:paddingBottom="@dimen/ms_space_4"
        android:textColor="@color/ms_on_dark"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHandsWarning"
        tools:text="Low light. Move to a brighter spot."
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvUncertaintyBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ms_screen_padding"
        android:layout_marginTop="106dp"
        android:layout_marginEnd="@dimen/ms_screen_padding"
        android:background="@drawable/bg_ms_pill"
        android:backgroundTint="@color/ms_danger"
        android:gravity="center"
        android:paddingStart="@dimen/ms_space_16"
        android:paddingTop="9dp"
        android:paddingEnd="@dimen/ms_space_16"
        android:paddingBottom="9dp"
        android:fontFamily="sans-serif"
        android:textSize="14sp"
        android:textColor="@color/ms_on_dark"
        android:elevation="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Uncertain whether gesture means KNOW or DON'T UNDERSTAND." />

    <!-- Detection percentage and Siri animated gradient progress bar -->

    <!-- Live mode readout, in the same place as the record button. Its children
         are shown/hidden individually by renderTapState(); with all three gone the
         container collapses. -->
        <!-- Left-aligned status: loading/ready text alongside blinking dot above detection meter -->
    <LinearLayout
        android:id="@+id/statusLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ms_screen_padding"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/detectionContainer"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ms_status_dot"
                android:backgroundTint="@color/ms_success"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/statusSpinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/ms_on_dark" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvStatus"
            style="@style/Sigla.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Starting camera…"
            android:textColor="@color/ms_on_dark" />
    </LinearLayout>

<LinearLayout
        android:id="@+id/detectionContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ms_screen_padding"
        android:layout_marginEnd="@dimen/ms_screen_padding"
        android:layout_marginBottom="@dimen/ms_space_12"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomSheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ms_space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetectionLabel"
                style="@style/Sigla.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detecting"
                android:textColor="@color/ms_on_dark" />

            <TextView
                android:id="@+id/tvBufferPercent"
                style="@style/Sigla.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/ms_on_dark" />
        </LinearLayout>

        <com.example.motionspeak.SiriDetectionMeterView
            android:id="@+id/progressBuffer"
            android:layout_width="match_parent"
            android:layout_height="14dp" />
    </LinearLayout>

    <!-- Marks 28dp inside the sheet, where the camera ends. -->
    <Space
        android:id="@+id/sheetOverlap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottomSheet" />

    <!-- Expanded Drawer / Bottom Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        android:layout_width="0dp"
        android:layout_height="280dp"
        app:cardBackgroundColor="@color/ms_bg"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Sigla.TopSheet"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/ms_screen_padding"
            android:paddingTop="@dimen/ms_space_12"
            android:paddingEnd="@dimen/ms_screen_padding"
            android:paddingBottom="@dimen/ms_space_16">

            <!-- Handle bar -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/ms_space_12"
                android:background="@drawable/bg_ms_pill"
                android:backgroundTint="@color/ms_divider" />

            <!-- [top] action button row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ms_space_8">

                <!-- Center: Turn into sentence button inside dialogue box panel (solid vibrant pill) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMakeSentence"
                    style="@style/Widget.Sigla.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:minHeight="34dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="Turn into sentence"
                    android:textSize="12sp"
                    android:textColor="@color/ms_on_brand"
                    android:clickable="true"
                    android:focusable="true"
                    android:alpha="1.0"
                    android:elevation="4dp"
                    app:elevation="4dp"
                    app:backgroundTint="@color/ms_brand"
                    app:cornerRadius="17dp"
                    app:icon="@drawable/ic_chat_line"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/ms_on_brand" />

                <!-- Right side: Words / Letters toggle -->
                <LinearLayout
                    android:id="@+id/btnToggleVocabulary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipWords"
                        style="@style/Widget.Sigla.Chip"
                        android:layout_marginEnd="@dimen/ms_space_8"
                        android:text="Words" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipLetters"
                        style="@style/Widget.Sigla.Chip"
                        android:layout_marginEnd="@dimen/ms_space_8"
                        android:text="Letters" />
                </LinearLayout>
            </RelativeLayout>

            <!-- [bottom] message box: scrollable to support incoming strings -->
            <FrameLayout
                android:id="@+id/boxMessageContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="46dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMessageBox"
                    style="@style/Widget.Sigla.Card.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/ms_tint"
                    app:cardCornerRadius="@dimen/ms_radius_md"
                    app:strokeColor="@color/ms_divider"
                    app:strokeWidth="1dp">

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/scrollMessageBox"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:padding="@dimen/ms_space_12">

                        <EditText
                            android:id="@+id/tvMessage"
                            style="@style/Sigla.Text"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:textSize="18sp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/ms_text"
                            android:hint="Translated signs will appear here…"
                            android:textColorHint="@color/ms_text_secondary"
                            android:importantForAutofill="no"
                            android:cursorVisible="true"
                            android:textCursorDrawable="@null" />
                    </androidx.core.widget.NestedScrollView>
                </com.google.android.material.card.MaterialCardView>

                <!-- Siri gradient border overlay over the card outline when in sentence state -->
                <com.example.motionspeak.SiriGradientBorderView
                    android:id="@+id/siriBorderView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating action buttons sitting on top of the drawer layer-wise -->

    <!-- Left side: Copy button (Purple) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyMessage"
        style="@style/Widget.Sigla.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="14dp"
        android:contentDescription="Copy message"
        android:elevation="14dp"
        app:elevation="14dp"
        app:backgroundTint="@color/ms_cat_purple_bg"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_copy"
        app:iconSize="20dp"
        app:iconTint="@color/ms_cat_purple_text"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="@id/btnClearMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnClearMessage" />

    <!-- Right side [bottom]: Speak button (Blue) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSpeakMessage"
        style="@style/Widget.Sigla.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="28dp"
        android:contentDescription="Speak message"
        android:elevation="14dp"
        app:elevation="14dp"
        app:backgroundTint="@color/ms_cat_blue_bg"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_volume_up"
        app:iconSize="20dp"
        app:iconTint="@color/ms_cat_blue_text"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Right side: Clear "X" button (Red) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearMessage"
        style="@style/Widget.Sigla.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="Clear message"
        android:elevation="14dp"
        app:elevation="14dp"
        app:backgroundTint="@color/ms_danger"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_close_line"
        app:iconSize="20dp"
        app:iconTint="@color/ms_on_dark"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnSpeakMessage"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Right side: Backspace button (below Flip Camera, above Clear) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackspace"
        style="@style/Widget.Sigla.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="Backspace"
        android:elevation="14dp"
        app:elevation="14dp"
        app:backgroundTint="@color/ms_bg"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_backspace"
        app:iconSize="20dp"
        app:iconTint="@color/ms_text"
        app:strokeColor="@color/ms_divider"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/btnClearMessage"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Right side [top]: Flip Camera button, right anchored above the Backspace button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFlipCamera"
        style="@style/Widget.Sigla.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="Flip camera"
        android:elevation="14dp"
        app:elevation="14dp"
        app:backgroundTint="@color/ms_bg"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_camera_flip"
        app:iconSize="20dp"
        app:iconTint="@color/ms_brand_text"
        app:strokeColor="@color/ms_brand_text"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toTopOf="@id/btnBackspace"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Right-aligned notification badge: # low conf, on the right side above the detection meter -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/badgeUncertainWords"
        style="@style/Widget.Sigla.Card"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/ms_screen_padding"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/ms_danger"
        app:cardCornerRadius="18dp"
        app:cardElevation="14dp"
        app:strokeColor="@color/ms_on_dark"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toTopOf="@id/detectionContainer"
        app:layout_constraintEnd_toEndOf="@id/detectionContainer">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_sos_alert"
                app:tint="@color/ms_on_dark"
                android:contentDescription="Review needed" />

            <TextView
                android:id="@+id/tvUncertainWordsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ms_on_dark"
                android:textSize="12sp"
                android:text="1 low conf" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ════════════════════ FLOATING TEST MENU TOGGLE (DRAGGABLE & ACCESSIBLE) ════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFloatingTestToggle"
        style="@style/Widget.Sigla.Card.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ms_space_16"
        android:layout_marginEnd="@dimen/ms_space_16"
        android:clickable="true"
        android:focusable="true"
        android:elevation="35dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/ms_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="28dp"
        app:strokeColor="@color/ms_cat_violet_accent"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_ms_circle_tint"
                android:backgroundTint="@color/ms_cat_violet_bg">

                <ImageView
                    android:id="@+id/ivFloatingTestIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="Toggle test menu"
                    android:src="@drawable/ic_tag_line"
                    app:tint="@color/ms_cat_violet_text" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvFloatingTestLabel"
                style="@style/Sigla.Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Test Menu"
                android:textColor="@color/ms_cat_violet_text"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
